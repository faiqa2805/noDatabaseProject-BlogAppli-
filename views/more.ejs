<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>More - Analytics Dashboard</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

  <nav>
    <a href="/">Home</a>
    <a href="/more" style="font-weight: bold;">More</a>
  </nav>

  <div class="dashboard-wrapper">
    <h1>Dashboard & Contact Information</h1>
    <hr class="section-divider">

    <section style="margin-bottom: 40px;">
      <h2>Blog Analytics</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <i class="fa-solid fa-book-open stat-icon"></i>
          <div>
            <h3>Total Blogs</h3>
            <p class="stat-number"><%= totalBlogs %></p>
          </div>
        </div>
        
        <div class="stat-card">
          <i class="fa-solid fa-pen-nib stat-icon"></i>
          <div>
            <h3>Total Words Written</h3>
            <p class="stat-number"><%= totalWords %></p>
          </div>
        </div>
      </div>
    </section>

    <hr class="section-divider">

    <section class="contact-section">
      <h2>Contact Us</h2>
      <p>Feel free to reach out or check out my work across the web!</p>
      
      <div class="social-links-container">
        <a href="https://www.linkedin.com/in/faiqaaaa/" target="_blank" class="social-link linkedin">
          <i class="fab fa-linkedin"></i> LinkedIn
        </a>

        <a href="https://github.com/faiqa2805" target="_blank" class="social-link github">
          <i class="fab fa-github"></i> GitHub
        </a>
      </div>
    </section>
  </div>

</body>
</html>